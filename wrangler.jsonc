{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afterlight-radio",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "APP_ENV": "production"
  }
}
