{
  "name": "afterlight-radio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Premium 12-room place-based listening experience for Cloudflare Workers",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run build && npm run check",
    "serve": "python3 -m http.server 4173 -d public",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.34.0"
  }
}
